  "algorithms": {
    "note": "每个公式量/边的「算法锚点」：它在代码里怎么算（how）、多久算一次（when）、受哪些离散化参数控制（discretization）、落在哪（where）。判据见本目录 README 第三节：查证过的写实，没查的进 algorithmPending 列表——不留空、不猜。",
    "byId": {
      "scaling_relations": {
        "how": "把天体物理参数折算成「晕属性 → 星系属性」的换算核：恒星质量份额、恒星形成率、逃逸分数、金属性、X 射线亮度（atlas L4 · S12.1.1 原文「在此定型」）；质量下限按 LW 强度与再电离反馈给出（S12.1.2 原文）",
        "when": "按红移装配：函数签名带 redshift（scaling_relations.c:36 void set_scaling_constants(double redshift, ...)），每次调用装配一个红移的常数",
        "discretization": "INTEGRATION_METHOD_ATOMIC / INTEGRATION_METHOD_MINI（只在走条件积分路径时起作用，HaloBox.c:392,394）",
        "where": "src/py21cmfast/src/scaling_relations.c:36 set_scaling_constants；质量下限在 src/py21cmfast/src/thermochem.c:278-300"
      },
      "source_grid": {
        "how": "先清零源项网格，再按 SOURCE_MODEL 选「离散晕累加」或「条件积分表」两条路径（atlas L4 · S12.2.1 原文）",
        "when": "每次调用构建一个红移的源项网格（调用点未核对，按 L4 的「该快照」口径记）",
        "discretization": "INTEGRATION_METHOD_ATOMIC / _MINI（HaloBox.c:392,394）；条件积分表的区间由 M_MIN_INTEGRAL / M_MAX_INTEGRAL 定（L4 · S07.4.1 关键量）",
        "where": "src/py21cmfast/src/HaloBox.c:563-664 ComputeHaloBox；累加 HaloBox.c:518-560；条件积分表 HaloBox.c:296-435"
      },
      "q_hii": {
        "how": "每快照先算全局量（平均塌缩分数、电离光子期望、两组塌缩分数下限），再逐半径滤波、逐格点积分塌缩分数给出电离判据；判为尚无电离源时直接写完全中性的盒并跳过后续（atlas L4 · S13.3.1 / 3.3.2 / 3.3.3 / 3.4.3 原文）",
        "when": "每个红移（快照）一次；内部另有一层滤波半径循环（L4 · S13.4.2 原文「在半径循环中复用同一份变换」）",
        "discretization": "滤波半径序列（L4 · S13.1.2）、INTEGRATION_METHOD_ATOMIC / _MINI（IonisationBox.c:725,727,1445,1452）、USE_EXP_FILTER 的滤波核（IonisationBox.c:614）",
        "where": "src/py21cmfast/src/IonisationBox.c（整箱；关键过程见 L4 · S13.x）"
      },
      "ts": {
        "how": "沿视线把加热与耦合在分好的壳层上积分，最后按 Eq.5 做调和平均得到自旋温度",
        "when": "每次调用算一个红移；壳层结构在调用内建立（SpinTemperatureBox.c:120-123 按 N_STEP_TS 分配数组）",
        "discretization": "径向环：R_MAX_TS（最大半径）× N_STEP_TS（环数），半径按对数铺开——SpinTemperatureBox.c:330 的 R_factor = (R_MAX_TS / R)^(1 / N_STEP_TS)",
