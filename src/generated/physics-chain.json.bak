        "when": "每次运行一次（与功率谱 / σ(R) 表同一次调用里算）",
        "discretization": "k 网格由 DIM / BOX_LEN 定；各条拟合式自带形状参数（Γ 等），不需额外输入",
        "where": "src/py21cmfast/src/cosmology.c:213 transfer_function（分派 EH :53 / BBKS :76 / Efstathiou :89 / Peebles :101 / White :114 / CLASS :131）"
      },
      "initial_density": {
        "how": "在 k 空间抽复高斯随机场、乘上线性功率谱并归一化，再逆变换回实空间得线性密度场（除以体元）",
        "when": "每次运行一次（初始条件只在起始红移算一遍）",
        "discretization": "网格 DIM / HII_DIM 与 BOX_LEN；随机种子 SEED；k 空间的模间隔由盒长定",
        "where": "src/py21cmfast/src/InitialConditions.c:728（boxes->lowres_density 写入）"
      },
      "zeldovich_velocity": {
        "how": "密度场在 k 空间乘 i·k/k² 得位移场，再按线性生长因子与 f(z)=dlnD/dlna 换算成一阶速度场，写进速度三分量",
        "when": "每次运行一次（与初始条件同一次调用）",
        "discretization": "网格 DIM（PERTURB_ON_HIGH_RES 时用高分辨）与 HII_DIM；k 空间的方向算子由盒长定",
        "where": "src/py21cmfast/src/InitialConditions.c:299 compute_velocity_fields（指针绑定 :593）"
      },
      "second_order_velocity": {
        "how": "由二阶位移场的源项在 k 空间解出二阶位移，再叠到速度场上（二阶拉格朗日微扰）",
        "when": "每次运行一次；开关 SECOND_ORDER_LPT_ICS 关掉时这一步不算",
        "discretization": "同初始条件的网格参数（DIM / BOX_LEN 与 HII_DIM）；两个源项场各做一次 k 空间求解",
        "where": "src/py21cmfast/src/InitialConditions.c:366 compute_velocity_fields_2LPT（指针绑定 :596）"
      },
      "perturb_velocity": {
        "how": "扰动密度场在 k 空间乘方向分量（i·k_i/k²）得速度分量，按生长因子换算后写进 velocity_x / velocity_z",
        "when": "每个红移一次（与扰动密度场同一次调用）",
        "discretization": "低分辨网格 HII_DIM；PERTURB_ALGORITHM 决定位移方式",
        "where": "src/py21cmfast/src/PerturbedField.c:280 compute_perturbed_velocities（写 velocity_x :466 / velocity_z :471）"
      },
      "filtered_sfr": {
        "how": "恒星形成率网格按 [R_inner, R_outer] 环壳滤波（one_annular_filter），逐红移切片累进 XraySourceBox.filtered_sfr",
        "when": "每个红移一次；内部对 N_STEP_TS 个半径分箱各滤一遍",
        "discretization": "半径分箱 N_STEP_TS（外半径 R_MAX_TS）与当前环壳的索引 R_ct",
        "where": "src/py21cmfast/src/SpinTemperatureBox.c:762-764 one_annular_filter（写 filtered_sfr）"
      },
      "mean_sfr": {
        "how": "同一次环形滤波顺带算出的体积平均（fsfr_avg），逐红移赋给 mean_sfr，供恒星形成率密度的自洽修正项用",
        "when": "每个红移一次（与滤波场同一次调用）",
        "discretization": "同滤波场的半径分箱 N_STEP_TS / R_MAX_TS",
        "where": "src/py21cmfast/src/SpinTemperatureBox.c:743 出 fsfr_avg，:769 写 source_box->mean_sfr"
      },
      "gamma_12": {
        "how": "电离判据判定格点已电离时，把该处算得的电离光子率（单位 1e12 s⁻¹）写进 ionisation_rate_G12",
        "when": "每个红移一次（逐格点）",
        "discretization": "滤波半径序列；积分方法开关 INTEGRATION_METHOD_ATOMIC / _MINI（:725,:727）",
        "where": "src/py21cmfast/src/IonisationBox.c:1123（写 ionisation_rate_G12）"
      },
      "recomb": {
        "how": "本轮复合量 dNrec 由复合系数（Case A / Case B 插值表）与时间步长相乘得到，再累加到上一红移的累积复合数上",
        "when": "每个红移一次，带跨红移记忆（累加量）",
        "discretization": "复合系数插值表的分辨率；时间步长由相邻快照的红移差定",
        "where": "src/py21cmfast/src/IonisationBox.c:1277 dNrec → :1291-1292 cumulative_recombinations"
      },
      "mfp": {
        "how": "电离判据里气泡半径积分的收敛半径 rspec.R 写进 mean_free_path，代表该格点处的电离区尺度",
        "when": "每个红移一次（逐格点）",
        "discretization": "滤波半径序列（最大自由程用 Songaila+2010 拟合式，:182）与积分方法开关",
        "where": "src/py21cmfast/src/IonisationBox.c:1132（写 mean_free_path）"
      },
      "z_reion": {
        "how": "格点首次被电离时把当前红移写进 z_reion，否则沿用上一快照的值；全场初始化为 -1",
        "when": "每个红移一次，带跨红移记忆（只在首次电离时写入）",
        "discretization": "红移快照间隔（由用户给的红移列表 / ZPRIME_STEP 定）",
        "where": "src/py21cmfast/src/IonisationBox.c:1137-1140（写 z_reion；初始化 :379 / :1360）"
      },
      "transfer_fn->matter_power": {
        "how": "σ(R) 与 dσ²/dM 由 P(k)=T²(k)·kⁿ 做 top-hat 窗积分得到，T(k) 是 P(k) 的一个因子",
        "when": "每次运行一次（常数化，不随红移重算）",
        "discretization": "k 空间积分网格（LOG_K_NUM / k 上下限）",
        "where": "src/py21cmfast/src/cosmology.c:398 sigma_z0 / :450 dsigmasqdm_z0"
      },
      "initial_density->zeldovich_velocity": {
        "how": "位移场 = 密度场的 k 空间梯度（i·k/k²）",
        "when": "每次运行一次（与初始条件同一次调用）",
        "discretization": "网格 DIM / HII_DIM 与盒长",
        "where": "src/py21cmfast/src/InitialConditions.c:299（下游指针绑定 :593）"
      },
      "initial_density->second_order_velocity": {
        "how": "二阶位移由密度场的二阶源项在 k 空间解出",
        "when": "每次运行一次（开关 SECOND_ORDER_LPT_ICS 打开时）",
        "discretization": "同初始条件的网格参数；两个源项场各一次 k 空间求解",
        "where": "src/py21cmfast/src/InitialConditions.c:366（下游指针绑定 :596）"
      },
      "perturb_field->perturb_velocity": {
        "how": "扰动密度场经 k 空间方向算子得速度分量",
        "when": "每个红移一次（密度写入之后紧接着算）",
        "discretization": "低分辨网格 HII_DIM",
        "where": "src/py21cmfast/src/PerturbedField.c:455（写 density）→ :466/:471"
      },
      "filtered_sfr->mean_sfr": {
        "how": "同一次环形滤波给出滤波场与它的体积平均",
        "when": "每个红移一次",
        "discretization": "半径分箱 N_STEP_TS / R_MAX_TS",
        "where": "src/py21cmfast/src/SpinTemperatureBox.c:743 → :769"
      },
      "gamma_12->q_hii": {
        "how": "中性分数与电离光子率在同一段判据循环里算出（同一格点、同一半径）",
        "when": "每个红移一次（逐格点）",
        "discretization": "滤波半径序列与积分方法开关",
        "where": "src/py21cmfast/src/IonisationBox.c:1123 → :1145（find_ionised_regions 内）"
      },
      "recomb->q_hii": {
        "how": "电离判据要减掉累积复合量：上一红移的 cumulative_recombinations 是本步电离平衡的一阶项",
        "when": "每个红移一次，带跨红移记忆",
        "discretization": "复合系数插值表；时间步长由相邻快照红移差定",
        "where": "src/py21cmfast/src/IonisationBox.c:1085 读入 → :1277 参与判据"
      },
      "q_hii->mfp": {
        "how": "电离区的收敛半径即光子的平均自由程，与中性分数由同一判据给出",
        "when": "每个红移一次（逐格点）",
        "discretization": "滤波半径序列与最大自由程拟合式",
        "where": "src/py21cmfast/src/IonisationBox.c:1132"
      },
      "q_hii->z_reion": {
        "how": "格点首次电离时记下红移，供下一红移的电离反馈改 M_turn 用",
        "when": "每个红移一次，带跨红移记忆（只在首次电离时写入）",
        "discretization": "红移快照间隔",
        "where": "src/py21cmfast/src/IonisationBox.c:1137-1140"
      }
    }
  },
