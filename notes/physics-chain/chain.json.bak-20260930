      "q_hii->p21": { "how": "Eq.11 里经 P_xx 项（电离涨落）", "when": "分析层", "discretization": "K_TARGET", "where": "**代码不产出**（正面结论）：同 dtb->p21，功率谱属分析层" },
      "fstar->phi_uv": { "how": "φ 的 Schechter 参数由 ρ̇* 定，进而依赖 f*（Eq.13）", "when": "每个红移一次（诊断）", "discretization": "—", "where": "LuminosityFunction.c ComputeLF" },
      "mmin->phi_uv": { "how": "Eq.13 里经 f_coll(M_min)", "when": "每个红移一次（诊断）", "discretization": "—", "where": "LuminosityFunction.c ComputeLF" },
      "rho_star->phi_uv": { "how": "Eq.13 的 φ*、M*、α 由 ρ̇* 给出", "when": "每个红移一次（诊断）", "discretization": "—", "where": "LuminosityFunction.c ComputeLF" },
      "q_hii->tau_e": { "how": "Eq.17 的被积函数（1 − x_HI）", "when": "输出时沿整段红移历史积分", "discretization": "—", "where": "src/py21cmfast/src（compute_tau，S04 旁路）" }
    }
  },
