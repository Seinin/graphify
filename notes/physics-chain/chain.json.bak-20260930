      "kind": "quantity",
      "page": 3,
      "eq": "Eq.3",
      "formula": "dQ_HII/dt = Ṅ_ion/n̄_H − α_B C n̄_H Q_HII (1+z)^3",
      "dependsOn": ["nion"],
      "nature": {
        "type": "一阶非线性 ODE（复合项 ∝ Q_HII，源项含指数）",
        "homogeneity": "非齐次（存在与 Q 无关的电离光子源项）",
        "coupling": "单向弱耦合：由 Ṅ_ion 驱动，不反馈",
        "nonlocal": "有记忆：Q(z) 依赖所有 z' > z 的积分历史",
        "degenerate": "是（见 Ṅ_ion 的 ζ·f* 简并）"
      },
      "sections": ["III 中性氢分数", "X 总结性数学性质表"],
      "codeHints": ["S13"],
      "reviewSection": "§3.3"
    },
