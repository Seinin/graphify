      "name": "21cm 平均亮温",
      "kind": "quantity",
      "observable": true,
      "page": 6,
      "eq": "Eq.9",
      "formula": "δT_b(z) = 27 · x_HI(z) · (1 − T_γ/T_S) · ((1+z)/10)^{1/2} · (Ω_b h²/0.023) · (0.15/(Ω_m h²))^{1/2}  [mK]",
      "dependsOn": ["q_hii", "tgamma", "ts"],
