    {
      "id": "p21",
      "theory": "理论出处：推导 PDF · Eq.10–Eq.11（Δ²_21(k,z) 与 P_21）。**代码根本不产出它**——它是分析层对 δT_b 的盒子做 k 空间统计得到的，所以图上它没有一条源码落点（这一条已知，不是遗漏）。",
      "symbol": "P_21(k,z)",
      "name": "21cm 功率谱",
      "kind": "spectrum",
      "observable": true,
      "page": 6,
      "eq": "Eq.10–Eq.11",
      "formula": "Δ²_21(k,z) = k³/(2π²) · P_21(k,z)；P_21(k,z) = δT_b² [ μ⁴ P_δδ + 2μ² P_δx + P_xx ] + RSD 项",
      "dependsOn": [
        "dtb",
        "q_hii"
      ],
      "nature": {
        "type": "功率谱（k–z 二维）",
        "homogeneity": "—",
        "coupling": "δT_b 与 x_HI 以乘积进入，两者独立演化",
        "nonlocal": "否",
        "degenerate": "否",
        "note": "μ 为波矢与视线夹角的余弦；不同 μ 对应不同物理主导尺度（电离泡 vs X 射线加热区）"
      },
      "sections": [
        "V 21 cm 亮温度",
        "VIII"
      ],
      "codeHints": [
        "S15"
      ],
      "reviewSection": "§4 涨落与功率谱（§4.1 红移空间畸变、§4.2 电离涨落）"
    },
